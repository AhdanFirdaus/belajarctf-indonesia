---
import Layout from '../layouts/Layout.astro';
import { AppExplorer } from '../components/react/AppExplorer';
import { resources } from '../data/resources';
---

<Layout>
  <div class="relative min-h-screen flex flex-col justify-between">
    <!-- Interactive React Explorer Island (Hydrates during browser idle time for optimal mobile performance) -->
    <AppExplorer
      client:idle
      initialResources={resources}
    />
  </div>
</Layout>