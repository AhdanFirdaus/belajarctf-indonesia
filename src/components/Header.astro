---

---

<header class="w-full max-w-4xl mx-auto pt-16 pb-6 px-4 text-center">
  <!-- Main Pixel Heading -->
  <h1
    class="text-3xl sm:text-5xl md:text-6xl font-pixel text-white uppercase tracking-wider mb-4 leading-tight"
  >
    PANDUAN BELAJAR CTF
  </h1>

  <!-- Purpose / Mission Statement -->
  <p
    class="text-base sm:text-lg text-neutral-300 max-w-2xl mx-auto font-normal leading-relaxed mb-6"
  >
    Jalur belajar terstruktur dan kurasi perangkat penting untuk memulai
    kompetisi <span
      class="text-white font-semibold underline decoration-neutral-700 underline-offset-4"
      >Capture The Flag (CTF)</span
    > dalam Bahasa Indonesia — <strong class="text-white"
      >dirancang khusus dari nol untuk pemula</strong
    >.
  </p>

  <!-- Creator GitHub Link Badge with Profile Picture -->
  <div class="flex items-center justify-center">
    <a
      href="https://github.com/AhdanFirdaus"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-2.5 border border-neutral-800 bg-[#121212] px-3.5 py-1.5 text-xs font-mono uppercase tracking-wider text-neutral-400 hover:text-white hover:border-white transition-all cursor-pointer"
    >
      <img
        src="https://github.com/AhdanFirdaus.png?size=48"
        alt="Dadan (@AhdanFirdaus)"
        width="20"
        height="20"
        decoding="async"
        class="w-5 h-5 border border-neutral-700 group-hover:border-white object-cover grayscale group-hover:grayscale-0 transition-all shrink-0"
        loading="lazy"
      />
      <span>DIBUAT OLEH DADAN</span>
      <span class="text-neutral-600 group-hover:text-neutral-400">/</span>
      <span class="text-neutral-300 group-hover:text-white font-semibold"
        >@AhdanFirdaus</span
      >
      <span class="text-neutral-500 group-hover:text-white">↗</span>
    </a>
  </div>
</header>
